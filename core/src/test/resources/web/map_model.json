{
  "about": "Research Map model parity fixture (Benchjot web + Android). Web: tests/map-model.test.ts. Every rule and expected value here is the contract both apps implement; change it here first, then in both apps.",
  "version": 1,
  "rules": {
    "edgeOrder": "structural edges first, walking notes in input order: parent (parent -> child) then derived (origin -> attempt); then link edges in link input order",
    "linkDedupe": "a link is dropped if: target unresolved (id must exist; label-only resolves by case-insensitive trimmed title), self-link, source missing, its unordered pair already has a parent or derived edge, or the same directed link was already added. A link B->A when A->B exists sets mutual=true on the A->B edge and adds nothing",
    "degree": "number of kept edges touching the node",
    "radius": {
      "base": 4,
      "perSqrtDegree": 1.5,
      "max": 10,
      "formula": "min(max, base + perSqrtDegree * sqrt(degree))"
    },
    "hitRadius": 24,
    "depth": {
      "min": 1,
      "max": 3,
      "default": 1,
      "parse": "a whole number string is clamped to [min,max]; anything else (missing, empty, decimal, text) gives default"
    },
    "around": "BFS from the focus over every kept edge, ignoring direction, up to depth hops; nodes in input order; edges with both ends inside; layout of the sub-graph is translated so the focus sits at (0,0). Unknown focus gives an empty graph",
    "arrows": "derived: always. link and parent: when lens is around, or zoom >= 1. The arrow sits at the target end; a mutual link has arrows at both ends",
    "marks": {
      "unmarked": {
        "shape": "circle",
        "fill": false,
        "color": "fg",
        "strokeWidth": 1.5
      },
      "success": {
        "shape": "circle",
        "fill": true,
        "color": "fg"
      },
      "failed": {
        "shape": "diamond",
        "fill": true,
        "color": "fail"
      }
    },
    "edgeStyle": {
      "link": {
        "color": "muted",
        "dash": null,
        "width": 1
      },
      "parent": {
        "color": "faint",
        "dash": [
          4,
          4
        ],
        "width": 1
      },
      "derived": {
        "color": "fg",
        "dash": null,
        "width": 1.5
      }
    },
    "nodeLabel": "<displayTitle>, <successful|failed|unmarked>, <n> connection(s)  (displayTitle = trimmed title or 'Untitled'; '1 connection', otherwise 'connections')",
    "listGroups": [
      "Parent",
      "Sub-notes",
      "Links to",
      "Linked from",
      "Derived from",
      "Attempts from this",
      "Further away"
    ],
    "listGroupRules": "Around list for a focus: Parent = parent edge target->focus source; Sub-notes = parent edges from focus; Links to = link edges from focus, or mutual links into focus; Linked from = link edges into focus, or mutual links from focus; Derived from = derived edge into focus; Attempts from this = derived edges from focus; Further away = nodes at hop >= 2. Items in node input order; empty groups left out",
    "minContrast": {
      "mark": 3,
      "text": 4.5
    },
    "errors": {
      "loadMap": "Couldn’t load the map.",
      "newAttempt": "Couldn’t start a new attempt."
    },
    "attemptTitle": "set by SQL new_attempt(): '<base> (attempt N)', base = the origin title without a trailing ' (attempt N)', 'Untitled' when empty; N = notes in the lineage family (root + every note derived from it, transitively) + 1"
  },
